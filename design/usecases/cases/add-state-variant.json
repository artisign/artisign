{
  "id": "add-state-variant",
  "title": "Add a state, overlay or step variant of a screen",
  "group": "variants",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "design-agent-dex"
  ],
  "constellations": [
    "design-team-large-project"
  ],
  "trigger": {
    "text": "Dana asks for a screen's empty, error or dialog state.",
    "actor": "designer-dana",
    "via": "ticket"
  },
  "goal": "The state lives next to its parent in the sidebar tree.",
  "outcome": "A variant screen with variant_of and variant_kind, nested under its parent.",
  "inputs": [
    {
      "object": "screen",
      "source": "Parent screen",
      "example": {
        "screen": "checkout"
      }
    }
  ],
  "outputs": [
    {
      "object": "screen",
      "target": "screens/",
      "example": {
        "screen": "checkout-empty",
        "variant_of": "checkout",
        "variant_kind": "state"
      }
    }
  ],
  "steps": [
    {
      "id": "write",
      "actor": "design-agent-dex",
      "action": "Writes the variant screen with stable structural ids",
      "via": "MCP"
    },
    {
      "id": "meta",
      "actor": "design-agent-dex",
      "action": "Sets variant_of and variant_kind with set_meta",
      "via": "MCP"
    },
    {
      "id": "tree",
      "actor": "system",
      "action": "Nests the variant under its parent in the sidebar",
      "target": {
        "screen": "sidebar-variant-tree"
      }
    }
  ]
}
