{
  "id": "coding-agent-reads-use-case",
  "title": "Coding agent reads a use case with everything attached",
  "group": "handoff",
  "tags": [
    "chr-1120",
    "chr-1160",
    "chr-1161"
  ],
  "status": "ready",
  "personas": [
    "coding-agent-coda"
  ],
  "constellations": [
    "coding-agent-ready-project"
  ],
  "trigger": {
    "text": "Coda picks up a ticket that names a use case.",
    "actor": "coding-agent-coda",
    "via": "ticket"
  },
  "goal": "Implement the flow without guessing.",
  "outcome": "One call returned the case, its personas, data objects and mapped screens, and for a case with a world also its entities, constellations, relationship types, starting state and every branch.",
  "inputs": [
    {
      "object": "use-case",
      "source": "Ticket tag",
      "example": {
        "id": "create-project"
      }
    }
  ],
  "outputs": [
    {
      "object": "screen",
      "target": "Codebase",
      "example": {
        "screen": "init-project-dialog"
      }
    }
  ],
  "steps": [
    {
      "id": "read",
      "actor": "coding-agent-coda",
      "action": "Calls get_use_case with the id",
      "via": "MCP"
    },
    {
      "id": "variant",
      "actor": "coding-agent-coda",
      "action": "Reads a variant resolved with variant id",
      "via": "MCP"
    },
    {
      "id": "check",
      "actor": "product-owner-pablo",
      "action": "Sees the same case in the detail view",
      "target": {
        "screen": "usecases-detail",
        "node": "btn-mapping"
      }
    }
  ],
  "branches": [
    {
      "id": "case-with-world",
      "title": "The case plays in a world",
      "from": "read",
      "when": [
        {
          "subject": "system",
          "property": "case_constellation_count",
          "op": "gt",
          "value": 0
        }
      ],
      "steps": [
        {
          "id": "read-world",
          "actor": "coding-agent-coda",
          "action": "Reads the entities, constellations and relationship types in the bundle, with the structured trigger and the starting state",
          "via": "MCP"
        },
        {
          "id": "implement-branches",
          "actor": "coding-agent-coda",
          "action": "Implements every branch lane; the bundle carries them all and never says which one applies",
          "via": "MCP"
        },
        {
          "id": "check-world",
          "actor": "product-owner-pablo",
          "action": "Sees the same world in the detail view",
          "target": {
            "screen": "usecases-detail-world",
            "node": "d-world"
          }
        }
      ],
      "rejoin": "variant"
    }
  ]
}
