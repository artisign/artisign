{
  "id": "compose-screen-from-refs",
  "title": "Compose a screen from refs and review it",
  "group": "design",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "design-agent-dex"
  ],
  "constellations": [
    "design-team-large-project"
  ],
  "trigger": {
    "text": "A ticket asks for a new screen.",
    "actor": "product-owner-pablo",
    "via": "ticket"
  },
  "goal": "The screen uses tokens and components only and renders without unresolved refs.",
  "outcome": "A screen with stable node ids, flows wired, and no red outlines.",
  "inputs": [
    {
      "object": "component",
      "source": "Design system",
      "example": {
        "name": "btn-primary"
      }
    }
  ],
  "outputs": [
    {
      "object": "screen",
      "target": "screens/",
      "example": {
        "screen": "checkout",
        "tags": [
          "chr-123"
        ]
      }
    }
  ],
  "steps": [
    {
      "id": "read-system",
      "actor": "design-agent-dex",
      "action": "Reads the design system at view tree",
      "via": "MCP"
    },
    {
      "id": "write",
      "actor": "design-agent-dex",
      "action": "Writes the screen with write_html, refs only",
      "via": "MCP"
    },
    {
      "id": "look",
      "actor": "design-agent-dex",
      "action": "Takes a screenshot and fixes red outlines before the next write",
      "via": "MCP"
    },
    {
      "id": "live",
      "actor": "system",
      "action": "Shows the new screen in the preview within a moment",
      "target": {
        "screen": "app-shell"
      }
    }
  ]
}
