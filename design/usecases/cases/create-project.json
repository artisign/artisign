{
  "id": "create-project",
  "title": "Create a new design project",
  "group": "setup",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "solo-founder-sol"
  ],
  "constellations": [
    "solo-founder-empty-project"
  ],
  "trigger": {
    "text": "No project is open and Sol wants to start designing.",
    "actor": "solo-founder-sol",
    "via": "browser preview"
  },
  "goal": "A new, empty Artisign project exists in a folder of Sol's choice.",
  "outcome": "The project is open in the tab and shows how to start.",
  "state": [
    {
      "subject": "system",
      "property": "open-project-count",
      "value": 0
    }
  ],
  "inputs": [
    {
      "object": "project",
      "source": "Folder browser",
      "example": {
        "root": "/Users/sol/coffee-finder/design"
      }
    }
  ],
  "outputs": [
    {
      "object": "project",
      "target": "artisign.json in the folder",
      "example": {
        "name": "coffee-finder",
        "open": true,
        "screen_count": 0
      }
    }
  ],
  "steps": [
    {
      "id": "start-create",
      "actor": "solo-founder-sol",
      "action": "Chooses Create project in the empty state",
      "target": {
        "screen": "no-project-empty-state",
        "node": "empty-btn-init"
      }
    },
    {
      "id": "browse-folder",
      "actor": "solo-founder-sol",
      "action": "Browses to a parent folder in the dialog",
      "target": {
        "screen": "init-project-dialog"
      }
    },
    {
      "id": "new-folder",
      "actor": "solo-founder-sol",
      "action": "Creates a new folder in place",
      "target": {
        "screen": "init-project-dialog",
        "node": "init-dialog-newfolder"
      }
    },
    {
      "id": "folder-created",
      "actor": "system",
      "action": "Creates the folder and selects it",
      "target": {
        "screen": "init-project-dialog-new-folder-created"
      }
    },
    {
      "id": "scaffold",
      "actor": "system",
      "action": "Scaffolds artisign.json and opens the project",
      "target": {
        "screen": "shell-empty-project"
      },
      "data": [
        {
          "object": "project",
          "before": {
            "open": false
          },
          "after": {
            "open": true,
            "screen_count": 0
          }
        }
      ]
    }
  ],
  "branches": [
    {
      "id": "folder-exists",
      "title": "Folder name already taken",
      "from": "new-folder",
      "when": [
        {
          "subject": "system",
          "property": "new-folder-exists",
          "value": true
        }
      ],
      "steps": [
        {
          "id": "name-taken",
          "actor": "system",
          "action": "Refuses the name and says the folder exists",
          "target": {
            "screen": "init-project-dialog-new-folder-exists"
          }
        }
      ],
      "rejoin": "new-folder"
    },
    {
      "id": "folder-name-invalid",
      "title": "Folder name not allowed",
      "from": "new-folder",
      "when": [
        {
          "subject": "system",
          "property": "new-folder-name-valid",
          "value": false
        }
      ],
      "steps": [
        {
          "id": "name-invalid",
          "actor": "system",
          "action": "Marks the name as invalid and keeps the dialog open",
          "target": {
            "screen": "init-project-dialog-new-folder-invalid"
          }
        }
      ],
      "rejoin": "new-folder"
    },
    {
      "id": "no-write-permission",
      "title": "Parent folder not writable",
      "from": "new-folder",
      "when": [
        {
          "subject": "system",
          "property": "parent-folder-writable",
          "value": false
        }
      ],
      "steps": [
        {
          "id": "permission-denied",
          "actor": "system",
          "action": "Says the folder cannot be created here",
          "target": {
            "screen": "init-project-dialog-new-folder-permission"
          }
        }
      ],
      "rejoin": "browse-folder"
    }
  ],
  "variants": [
    {
      "id": "agent",
      "title": "Agent creates the project through MCP",
      "description": "An agent has no dialog: it asks for the folder and calls init_project.",
      "when": {
        "actor-type": [
          "agent"
        ]
      },
      "personas": [
        "design-agent-dex"
      ],
      "trigger": {
        "text": "Sol asks the AI tool to create an Artisign project.",
        "actor": "solo-founder-sol",
        "via": "AI tool chat"
      },
      "steps": [
        {
          "op": "replace",
          "step_id": "start-create",
          "step": {
            "id": "ask-folder",
            "actor": "design-agent-dex",
            "action": "Asks the user where the project should live, then calls init_project",
            "via": "MCP"
          }
        },
        {
          "op": "remove",
          "step_id": "browse-folder"
        },
        {
          "op": "remove",
          "step_id": "new-folder"
        },
        {
          "op": "remove",
          "step_id": "folder-created"
        },
        {
          "op": "remove_branch",
          "branch_id": "folder-exists"
        },
        {
          "op": "remove_branch",
          "branch_id": "folder-name-invalid"
        },
        {
          "op": "remove_branch",
          "branch_id": "no-write-permission"
        }
      ]
    }
  ]
}
