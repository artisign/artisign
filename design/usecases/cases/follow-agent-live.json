{
  "id": "follow-agent-live",
  "title": "Follow the agent while it works",
  "group": "follow",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "designer-dana"
  ],
  "constellations": [
    "design-team-large-project"
  ],
  "trigger": {
    "text": "Dana hands the agent a task and wants to watch it work.",
    "actor": "designer-dana",
    "via": "browser preview"
  },
  "goal": "The preview shows whatever the agent touches.",
  "outcome": "Each tool call navigates and highlights the nodes; Dana's own navigation pauses following.",
  "state": [
    {
      "subject": "system",
      "property": "follow",
      "value": false
    }
  ],
  "inputs": [
    {
      "object": "settings",
      "source": "Topbar Follow pill",
      "example": {
        "follow": false
      }
    }
  ],
  "outputs": [
    {
      "object": "settings",
      "target": "Daemon settings",
      "example": {
        "follow": true
      }
    }
  ],
  "steps": [
    {
      "id": "turn-on",
      "actor": "designer-dana",
      "action": "Turns on Follow in the topbar",
      "target": {
        "screen": "follow-active-feed"
      },
      "data": [
        {
          "object": "settings",
          "before": {
            "follow": false
          },
          "after": {
            "follow": true
          }
        }
      ]
    },
    {
      "id": "highlight",
      "actor": "system",
      "action": "Navigates to the touched screen and highlights nodes",
      "target": {
        "screen": "follow-highlight-definition"
      }
    },
    {
      "id": "pause",
      "actor": "designer-dana",
      "action": "Clicks elsewhere, which pauses following",
      "target": {
        "screen": "follow-paused-node-highlights"
      }
    },
    {
      "id": "resume",
      "actor": "designer-dana",
      "action": "Resumes explicitly",
      "target": {
        "screen": "follow-active-feed"
      }
    }
  ],
  "branches": [
    {
      "id": "feed-empty",
      "title": "Agent has not called a tool yet",
      "from": "turn-on",
      "when": [
        {
          "subject": "system",
          "property": "activity-feed-length",
          "value": 0
        }
      ],
      "steps": [
        {
          "id": "show-empty-feed",
          "actor": "system",
          "action": "Shows the empty activity feed until the first tool call",
          "target": {
            "screen": "follow-feed-empty"
          }
        }
      ],
      "rejoin": "highlight"
    },
    {
      "id": "mockup-touched",
      "title": "Agent writes a mockup",
      "from": "highlight",
      "when": [
        {
          "subject": "system",
          "property": "touched-kind",
          "value": "mockup"
        }
      ],
      "steps": [
        {
          "id": "mockup-cue",
          "actor": "system",
          "action": "Shows a cue that the agent is working on a mockup",
          "target": {
            "screen": "follow-mockup-cue"
          }
        }
      ],
      "rejoin": "pause"
    }
  ]
}
