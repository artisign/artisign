{
  "id": "inspect-node",
  "title": "Inspect an element's tokens and geometry",
  "group": "review",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "designer-dana"
  ],
  "constellations": [
    "design-team-large-project"
  ],
  "trigger": {
    "text": "Dana wants to know which token an element uses.",
    "actor": "designer-dana",
    "via": "browser preview"
  },
  "goal": "See refs, computed values and size of one element.",
  "outcome": "The Elements panel shows the selected node's details.",
  "inputs": [
    {
      "object": "screen",
      "source": "Open screen",
      "example": {
        "screen": "checkout"
      }
    }
  ],
  "outputs": [
    {
      "object": "token",
      "target": "Inspector",
      "example": {
        "path": "color.primary",
        "value": "#3F6BFF"
      }
    }
  ],
  "steps": [
    {
      "id": "mode",
      "actor": "designer-dana",
      "action": "Turns on Inspect mode",
      "target": {
        "screen": "app-shell"
      }
    },
    {
      "id": "select",
      "actor": "designer-dana",
      "action": "Selects an element in the frame",
      "target": {
        "screen": "inspector-selected"
      }
    }
  ],
  "branches": [
    {
      "id": "variant-screen",
      "title": "The element is on a variant screen",
      "from": "select",
      "when": [
        {
          "subject": "system",
          "property": "selected-screen-is-variant",
          "value": true
        }
      ],
      "steps": [
        {
          "id": "variant-card",
          "actor": "system",
          "action": "Shows the Variant card and Also reached from for a variant screen",
          "target": {
            "screen": "inspector-variant-reached-from"
          }
        }
      ],
      "outcome": "Dana also sees the variant's parent and the screens that lead to it."
    }
  ]
}
