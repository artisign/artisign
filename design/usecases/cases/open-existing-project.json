{
  "id": "open-existing-project",
  "title": "Open an existing project",
  "group": "setup",
  "tags": [
    "chr-1120"
  ],
  "status": "ready",
  "personas": [
    "designer-dana"
  ],
  "trigger": "Dana wants to continue on a project that is not open.",
  "goal": "The project is open in this browser tab.",
  "outcome": "Screens, design system and board of the project are shown.",
  "inputs": [
    {
      "object": "project",
      "source": "Folder browser",
      "example": {
        "root": "/Users/dana/shop/design",
        "open": false
      }
    }
  ],
  "outputs": [
    {
      "object": "project",
      "target": "Daemon project list",
      "example": {
        "name": "shop",
        "open": true
      }
    }
  ],
  "steps": [
    {
      "id": "start-open",
      "actor": "designer-dana",
      "action": "Chooses Open project in the empty state",
      "target": {
        "screen": "no-project-empty-state",
        "node": "empty-btn-open"
      }
    },
    {
      "id": "pick-folder",
      "actor": "designer-dana",
      "action": "Picks the folder that holds artisign.json",
      "target": {
        "screen": "open-project-dialog"
      }
    },
    {
      "id": "open",
      "actor": "system",
      "action": "Opens the project and shows its first screen",
      "target": {
        "screen": "app-shell"
      },
      "data": [
        {
          "object": "project",
          "before": {
            "open": false
          },
          "after": {
            "open": true
          }
        }
      ]
    }
  ]
}
