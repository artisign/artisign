{
  "id": "present-ticket-on-board",
  "title": "Present a ticket's screens on the Board",
  "group": "board",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "design-agent-dex"
  ],
  "constellations": [
    "design-team-large-project"
  ],
  "trigger": {
    "text": "The agent finished the screens of a ticket and wants Dana to review them.",
    "actor": "design-agent-dex",
    "via": "MCP"
  },
  "goal": "Dana's open browser shows exactly the ticket's screens.",
  "outcome": "The Board is filtered to the ticket tag with the key screens pinned.",
  "inputs": [
    {
      "object": "screen",
      "source": "Ticket tag",
      "example": {
        "tags": [
          "chr-123"
        ]
      }
    }
  ],
  "outputs": [
    {
      "object": "board-state",
      "target": "Shared board state",
      "example": {
        "filter": "chr-123",
        "pinned": [
          "checkout"
        ]
      }
    }
  ],
  "steps": [
    {
      "id": "set-state",
      "actor": "design-agent-dex",
      "action": "Calls set_board_state with filter, pins and expanded clusters",
      "data": [
        {
          "object": "board-state",
          "before": {
            "filter": ""
          },
          "after": {
            "filter": "chr-123"
          }
        }
      ],
      "via": "MCP"
    },
    {
      "id": "switch",
      "actor": "system",
      "action": "Switches the open browser to the Board without a reload",
      "target": {
        "screen": "board-view-presented"
      }
    },
    {
      "id": "review",
      "actor": "designer-dana",
      "action": "Reviews the screens and their flow edges",
      "target": {
        "screen": "board-view-clusters-expanded"
      }
    }
  ],
  "branches": [
    {
      "id": "no-tagged-screens",
      "title": "No screen carries the ticket tag",
      "from": "set-state",
      "when": [
        {
          "subject": "system",
          "property": "screens-matching-filter",
          "value": 0
        }
      ],
      "steps": [
        {
          "id": "board-empty",
          "actor": "system",
          "action": "Shows the empty Board for the filter",
          "target": {
            "screen": "board-view-empty"
          }
        }
      ],
      "outcome": "Dex tags the screens and presents again."
    }
  ]
}
