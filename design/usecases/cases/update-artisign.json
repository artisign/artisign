{
  "id": "update-artisign",
  "title": "Update Artisign and read what's new",
  "group": "settings",
  "tags": [
    "chr-1120",
    "chr-1160"
  ],
  "status": "ready",
  "personas": [
    "solo-founder-sol"
  ],
  "constellations": [
    "solo-founder-empty-project"
  ],
  "trigger": {
    "text": "A newer Artisign version is published; the daemon's daily check finds it.",
    "actor": "npm-registry",
    "via": "registry metadata (daily update check)"
  },
  "goal": "Sol runs the new version and knows what changed.",
  "outcome": "The client entries are re-pinned and the release notes were shown once.",
  "state": [
    {
      "subject": "ai-tool-sol",
      "property": "pinned_version",
      "value": "2.2.1"
    }
  ],
  "inputs": [
    {
      "object": "settings",
      "source": "Update check",
      "example": {
        "version": "2.2.1"
      }
    }
  ],
  "outputs": [
    {
      "object": "settings",
      "target": "Daemon settings",
      "example": {
        "version": "2.3.0"
      }
    }
  ],
  "steps": [
    {
      "id": "notice",
      "actor": "system",
      "action": "Shows the update notice under the settings gear",
      "target": {
        "screen": "shell-update-notice"
      }
    },
    {
      "id": "run",
      "actor": "solo-founder-sol",
      "action": "Copies and runs artisign update, which re-pins the client entries",
      "data": [
        {
          "object": "mcp-client",
          "before": {
            "pinned_version": "2.2.1"
          },
          "after": {
            "pinned_version": "2.3.0"
          }
        }
      ],
      "via": "terminal"
    },
    {
      "id": "whats-new",
      "actor": "system",
      "action": "Shows the release notes on the first start after the update",
      "target": {
        "screen": "shell-whats-new"
      },
      "data": [
        {
          "object": "settings",
          "before": {
            "version": "2.2.1"
          },
          "after": {
            "version": "2.3.0"
          }
        }
      ]
    }
  ]
}
